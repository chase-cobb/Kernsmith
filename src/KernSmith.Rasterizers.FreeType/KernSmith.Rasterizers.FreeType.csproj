<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <PackageId>KernSmith.Rasterizers.FreeType</PackageId>
    <Description>FreeType rasterizer backend for KernSmith. Runs on Windows, Linux x64, macOS, and Android (not iOS, where it fails to link). Supports color fonts, variable fonts, SDF, and outline effects.</Description>
    <PackageProjectUrl>https://github.com/kaltinril/Kernsmith</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Kaltinril (Jeremy Swartwood)</Authors>
    <PackageTags>kernsmith;freetype;rasterizer;bitmap-font;game-dev;cross-platform;color-font;variable-font;sdf</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="buildTransitive\KernSmith.Rasterizers.FreeType.targets" Pack="true" PackagePath="build/;buildTransitive/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KernSmith.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FreeTypeSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KernSmith\KernSmith.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ILLink.Descriptors.xml">
      <LogicalName>ILLink.Descriptors.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
